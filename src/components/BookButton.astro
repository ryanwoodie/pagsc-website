---
// The site's one primary action: buy a Discovery Flight. Goes straight to the Wave checkout.
import Button from './Button.astro';
import { facts, money } from '../lib/facts';
interface Props { label?: string; small?: boolean; class?: string; showPrice?: boolean }
const { label = 'Buy a Discovery Flight', small, class: cls, showPrice = false } = Astro.props;
---
<Button href={facts.links.discovery_flight_payment} small={small} class={cls} external>{label}{showPrice && `, ${money(facts.discovery_flight.price)}`}</Button>
