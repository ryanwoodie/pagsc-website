---
// The site's one primary action. Everywhere except the Discovery Flight page it goes to that page,
// where the price, limits and booking are explained; on that page it buys (Stripe checkout) directly.
import Button from './Button.astro';
import { facts, money } from '../lib/facts';
interface Props { label?: string; small?: boolean; class?: string; showPrice?: boolean; buy?: boolean }
const { label, small, class: cls, showPrice = false, buy } = Astro.props;
const here = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '');
const direct = buy ?? here === '/discovery-flight/';
const text = (label ?? (direct ? 'Buy a Discovery Flight' : 'Book a Discovery Flight')) + (showPrice ? `, ${money(facts.discovery_flight.price)}` : '');
---
<Button href={direct ? facts.links.discovery_flight_payment : '/discovery-flight/'} small={small} class={cls} external={direct}>{text}</Button>
