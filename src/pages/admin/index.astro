---
// The club's admin page: bookings by day, standby, waivers and what needs attention. Not linked from the site
// and not indexed. Everything is fetched after sign-in from the Apps Script (apps-script/Admin.gs), which checks
// the sign-in token on every request; this page holds no data of its own.
import Base from '../../layouts/Base.astro';
import { FORM_ENDPOINT } from '../../config';
import { facts } from '../../lib/facts';
---
<Base title="Club admin" description={`Bookings, standby and waivers for the ${facts.club.name}.`} noindex>
  <section class="adm wrap" data-endpoint={FORM_ENDPOINT} data-max={facts.booking.max_group} data-price={facts.discovery_flight.price}
    data-group-price={facts.discovery_flight.group_price_each} data-group-min={facts.discovery_flight.group_minimum}>
    <h1>Club admin</h1>
    <div class="adm__app" aria-live="polite"><p class="adm__muted">Loading…</p></div>
  </section>
</Base>

<script>
  type Flyer = { id: string; name: string; email: string; waiver: string; flown: string; person: string };
  type Booking = {
    id: string; date: string; start: string; people: number; kind: string; status: string; name: string; email: string; phone: string;
    interest: string; payment: string; certificates: string; message: string; notes: string; flexible: string; movedFrom: string; followUp: string;
    flyers: Flyer[]; waivers: number;
  };
  type Slot = { time: string; free: boolean };
  type Standby = { token: string; name: string; email: string; phone: string; people: number; scope: string; status: string; codes: string };
  type Waiver = { id: string; name: string; email: string; phone: string; age: number; guardian: string; signed: string; signedDate: string };
  type DayData = {
    ok: boolean; date: string; error?: string;
    day: { status: string; weather: string; instructor: boolean; students: number; manual: number } | null;
    avail: { remaining: number; open: boolean; confirmed: boolean; kind: string; slots: Slot[] } | null;
    bookings: Booking[]; standby: Standby[]; waivers?: Waiver[]; people?: number;
  };
  type Attention = {
    requests: { row: number; received: string; name: string; email: string; phone: string; flyers: number; dates: string; message: string; payment: string }[];
    weekday: Booking[]; etransfers: { row: number; received: string; from: string; amount: number; message: string; result: string; reference: string; deposited: boolean }[];
    unpaid: Booking[]; waivers: Booking[]; orders: { reference: string; name: string; email: string; amount: number; flights: number; booked: string }[];
  };
  type All = { ok: boolean; error?: string; today: string; days: DayData[]; attention: Attention; waivers: Waiver[]; loaded?: string };

  const root = document.querySelector<HTMLElement>('.adm')!;
  const app = root.querySelector<HTMLElement>('.adm__app')!;
  const endpoint = root.dataset.endpoint!;
  const maxGroup = Number(root.dataset.max) || 4;
  const price = Number(root.dataset.price) || 50;
  const groupPrice = Number(root.dataset.groupPrice) || 40;
  const groupMin = Number(root.dataset.groupMin) || 4;
  const KEY = 'pagsc-admin';
  const DATA = 'pagsc-admin-data';
  // The last full load, kept on this device so the page shows at once while the latest loads.
  let data: All | null = null;
  let view: () => void = () => overview();
  let fresh = false;

  // ---------- helpers ----------
  function h<K extends keyof HTMLElementTagNameMap>(tag: K, attrs: Record<string, string> = {}, ...kids: (Node | string | null | false)[]) {
    const e = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v);
    for (const k of kids) if (k) e.append(k);
    return e;
  }
  const btn = (label: string, onClick: () => void, cls = 'adm__btn') => {
    const b = h('button', { type: 'button', class: cls }, label);
    b.addEventListener('click', onClick);
    return b;
  };
  const fmtDay = new Intl.DateTimeFormat('en-CA', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
  const fmtLong = new Intl.DateTimeFormat('en-CA', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' });
  const asDate = (iso: string) => new Date(iso + 'T12:00:00Z');
  const clock = (hhmm: string) => {
    const [hh, mm] = hhmm.split(':').map(Number);
    return `${((hh + 11) % 12) + 1}${mm ? ':' + String(mm).padStart(2, '0') : ''} ${hh < 12 ? 'am' : 'pm'}`;
  };
  const endOf = (start: string, people: number) => {
    const [hh, mm] = start.split(':').map(Number);
    const t = hh * 60 + mm + people * 30;
    return `${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`;
  };
  const shift = (iso: string, n: number) => new Date(asDate(iso).getTime() + n * 86400000).toISOString().slice(0, 10);

  function token() {
    try { return localStorage.getItem(KEY) || ''; } catch { return ''; }
  }

  async function api(action: string, data: Record<string, string> = {}): Promise<any> {
    const body = new URLSearchParams({ form: 'admin', action, token: token(), ...data });
    const res = await fetch(endpoint, { method: 'POST', body, signal: AbortSignal.timeout(60000) });
    const out = await res.json();
    if (out.error === 'signin') { signIn('Your sign-in has expired. Sign in again.'); throw new Error('signin'); }
    if (!out.ok) throw new Error(out.error || 'Something went wrong.');
    return out;
  }

  function loading(text = 'Loading…') {
    app.replaceChildren(h('p', { class: 'adm__muted' }, text));
  }

  function errorBox(e: unknown) {
    return h('p', { class: 'adm__error', role: 'alert' }, e instanceof Error ? e.message : 'Something went wrong.');
  }

  /** Run an action from a button, then reload the view. */
  async function act(button: HTMLButtonElement, action: string, data: Record<string, string>, after: () => void) {
    const label = button.textContent;
    button.disabled = true;
    button.textContent = 'Saving…';
    try {
      await api(action, data);
      button.textContent = 'Saved ✓';
      for (const f of app.querySelectorAll('.adm__panel, .adm__add')) f.replaceChildren();
      after();
    } catch (e) {
      if (e instanceof Error && e.message === 'signin') return;
      button.disabled = false;
      button.textContent = label;
      button.after(errorBox(e));
    }
  }

  // ---------- sign-in ----------
  function signIn(note = '') {
    try { localStorage.removeItem(KEY); localStorage.removeItem(DATA); } catch { /* storage blocked */ }
    data = null;
    const email = h('input', { type: 'email', id: 'adm-email', autocomplete: 'email', required: '' }) as HTMLInputElement;
    const send = h('button', { type: 'submit', class: 'btn' }, 'Email me a sign-in link');
    const form = h('form', { class: 'adm__signin' },
      note ? h('p', {}, note) : null,
      h('label', { for: 'adm-email' }, 'Club email'), email, send);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      send.setAttribute('disabled', '');
      send.textContent = 'Sending…';
      try {
        await fetch(endpoint, { method: 'POST', body: new URLSearchParams({ form: 'admin', action: 'login', email: email.value }) });
        form.replaceChildren(h('p', {}, `If ${email.value} is on the admin list, a sign-in link is on its way. Open it on this device.`));
      } catch {
        send.removeAttribute('disabled');
        send.textContent = 'Email me a sign-in link';
        form.append(errorBox(new Error('That did not go through. Try again.')));
      }
    });
    app.replaceChildren(form);
  }

  // ---------- loading ----------
  /** Load everything (one request), keep it, and redraw the current view. */
  async function refresh() {
    fresh = false;
    banner();
    try {
      const out: All = await api('all');
      out.loaded = new Date().toISOString();
      data = out;
      fresh = true;
      try { localStorage.setItem(DATA, JSON.stringify(out)); } catch { /* storage full or blocked */ }
      // Someone typing or with a form open keeps what they have; the banner offers the latest.
      const busy = app.contains(document.activeElement) && /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement!.tagName)
        || [...app.querySelectorAll('.adm__panel, .adm__add')].some((x) => x.childElementCount);
      if (busy) { banner('', true); return; }
      view();
    } catch (e) {
      if (e instanceof Error && e.message === 'signin') return;
      if (!data) app.replaceChildren(errorBox(e), btn('Try again', () => refresh()));
      else banner(e instanceof Error ? e.message : 'Could not load the latest.');
    }
  }

  /** A line at the top saying whether what is shown is the latest. */
  function banner(problem = '', waiting = false) {
    const old = root.querySelector('.adm__fresh');
    const line = waiting
      ? h('p', { class: 'adm__fresh' }, 'The latest is loaded. ', btn('Show it', () => view(), 'adm__link'))
      : h('p', { class: 'adm__fresh' + (problem ? ' adm__fresh--bad' : '') },
        problem ? `${problem} ` : fresh || !data ? '' : `Updating… (showing the copy from ${new Date(data.loaded || Date.now()).toLocaleTimeString('en-CA', { hour: 'numeric', minute: '2-digit' })})`,
        problem || fresh ? btn('Refresh', () => refresh(), 'adm__link') : '');
    if (old) old.replaceWith(line); else app.before(line);
  }

  function show(render: () => void) {
    view = render;
    render();
    banner();
  }

  // ---------- overview ----------
  function overview() {
    show(() => {
      if (!data) { loading(); return; }
      const all = data;
      const a = all.attention;
      const count = a.requests.length + a.weekday.length + a.etransfers.length + a.unpaid.length + a.waivers.length;
      const row = (d: DayData) => {
        const active = d.bookings.filter((b) => b.status !== 'Cancelled');
        return h('li', {}, btn(fmtDay.format(asDate(d.date)), () => day(d.date), 'adm__day'),
          h('span', { class: 'adm__daymeta' }, active.length ? `${active.length} booking${active.length === 1 ? '' : 's'}, ${d.people} ${d.people === 1 ? 'person' : 'people'}` : 'No bookings'),
          d.day?.status ? h('span', { class: 'adm__status' }, d.day.status) : null);
      };
      const ahead = all.days.filter((d) => d.date >= all.today);
      const past = all.days.filter((d) => d.date < all.today && d.bookings.length).reverse();
      const pick = h('input', { type: 'date', 'aria-label': 'Go to a date', value: all.today }) as HTMLInputElement;
      pick.addEventListener('change', () => pick.value && day(pick.value));
      app.replaceChildren(
        h('div', { class: 'adm__bar' }, btn(count ? `Needs attention (${count})` : 'Nothing needs attention', () => attention(), count ? 'adm__btn adm__btn--warn' : 'adm__btn'),
          btn('Today', () => day(all.today)), pick),
        h('h2', {}, 'Next four weeks'),
        h('ul', { class: 'adm__days' }, ...ahead.map(row)),
        past.length ? h('h2', {}, 'Last week') : '',
        past.length ? h('ul', { class: 'adm__days' }, ...past.map(row)) : '',
        h('p', { class: 'adm__muted' }, btn('Sign out', () => signIn(), 'adm__link')));
    });
  }

  // ---------- needs attention ----------
  function attention() {
    show(() => {
      if (!data) { loading(); return; }
      const a = data.attention;
      const sec = (title: string, items: HTMLElement[]) => items.length ? [h('h2', {}, title), ...items] : [];
      const bookingLine = (b: Booking, extra: string) => h('div', { class: 'adm__card' },
        h('p', {}, h('strong', {}, `${fmtDay.format(asDate(b.date))}, ${clock(b.start)}`), ` ${b.name} (${b.people})`),
        h('p', { class: 'adm__muted' }, extra), btn('Open the day', () => day(b.date)));
      const dismiss = (kind: string, row: number) => {
        const b = btn('Mark done', () => act(b, 'dismiss', { kind, row: String(row) }, refresh));
        return b;
      };
      app.replaceChildren(
        btn('← Back', () => overview(), 'adm__link'),
        h('h2', {}, 'Needs attention'),
        ...sec('Weekday requests to confirm', a.weekday.map((b) => bookingLine(b, b.phone))),
        ...sec('Waivers missing (next 2 days)', a.waivers.map((b) => bookingLine(b, `${b.waivers} of ${b.people} signed`))),
        ...sec('Waiting for an e-transfer', a.unpaid.map((b) => bookingLine(b, b.payment))),
        ...sec('Requests from the plain form', a.requests.map((r) => h('div', { class: 'adm__card' },
          h('p', {}, h('strong', {}, r.name), ` (${r.flyers}), ${r.dates}`),
          h('p', {}, h('a', { href: `tel:${r.phone}` }, r.phone), ' · ', h('a', { href: `mailto:${r.email}` }, r.email)),
          r.message ? h('p', { class: 'adm__muted' }, r.message) : null,
          h('p', { class: 'adm__muted' }, `${r.payment} · received ${new Date(r.received).toLocaleString('en-CA')}`),
          dismiss('request', r.row)))),
        ...sec('E-transfers to check', a.etransfers.map((t) => {
          const panel = h('div', { class: 'adm__panel' });
          const open = (fill: (p: HTMLElement) => void) => { panel.replaceChildren(); fill(panel); };
          return h('div', { class: 'adm__card' },
            h('p', {}, h('strong', {}, `$${t.amount}`), ` from ${t.from}`),
            h('p', { class: 'adm__muted' }, `${t.result}${t.message ? ` · "${t.message}"` : ''} · ${new Date(t.received).toLocaleDateString('en-CA')}`),
            h('div', { class: 'adm__actions' },
              btn('Issue certificates', () => open((p) => issueForm(p, t))),
              a.orders.length ? btn('Apply to an order', () => open((p) => applyForm(p, t, a.orders))) : '',
              dismiss('etransfer', t.row)),
            panel);
        })),
        a.weekday.length + a.waivers.length + a.unpaid.length + a.requests.length + a.etransfers.length ? '' : h('p', {}, 'Nothing needs attention.'));
    });
  }

  /** Certificates from an e-transfer: the sender is the buyer; the email is taken from their message if it has one. */
  function issueForm(p: HTMLElement, t: Attention['etransfers'][number]) {
    const field = (label: string, input: HTMLElement) => h('label', { class: 'adm__field' }, label, input);
    const guess = /[^\s@"]+@[^\s@"]+\.[A-Za-z]{2,}/.exec(t.message)?.[0] || '';
    // How many flights the amount pays for: $50 each, or the group price for 4 or more.
    let n = 1, each = t.amount;
    if (t.amount % price === 0 && t.amount / price < groupMin) { n = t.amount / price; each = price; }
    else if (t.amount % groupPrice === 0 && t.amount / groupPrice >= groupMin) { n = t.amount / groupPrice; each = groupPrice; }
    const name = h('input', { type: 'text', value: t.from, required: '' }) as HTMLInputElement;
    const email = h('input', { type: 'email', value: guess, required: '' }) as HTMLInputElement;
    const qty = h('select', {}, ...Array.from({ length: 10 }, (_, i) => h('option', { value: String(i + 1) }, String(i + 1)))) as HTMLSelectElement;
    qty.value = String(Math.min(n, 10));
    const value = h('input', { type: 'number', min: '1', step: '1', value: String(each) }) as HTMLInputElement;
    const forName = h('input', { type: 'text', placeholder: 'Name on the certificate, if a gift' }) as HTMLInputElement;
    const msg = h('input', { type: 'text', placeholder: 'Message on the certificate (optional)' }) as HTMLInputElement;
    const total = h('p', { class: 'adm__muted' });
    const sum = () => { total.textContent = `${qty.value} × $${value.value} = $${Number(qty.value) * Number(value.value)} (received $${t.amount})`; };
    qty.addEventListener('change', sum); value.addEventListener('input', sum); sum();
    const go = btn('Issue and email the certificates', () => {
      if (!name.value.trim() || !email.checkValidity() || !email.value) { email.reportValidity(); return; }
      act(go, 'etransfer-issue', { row: String(t.row), name: name.value, email: email.value, quantity: qty.value, value: value.value, recipient: forName.value, message: msg.value }, refresh);
    });
    p.append(field('Buyer', name), field('Email the certificates to', email), h('div', { class: 'adm__row' }, field('Flights', qty), field('Value each ($)', value)),
      total, field('For', forName), field('Message', msg), go);
  }

  /** An e-transfer sent without its reference, counted against the order it was for. */
  function applyForm(p: HTMLElement, t: Attention['etransfers'][number], orders: Attention['orders']) {
    const sel = h('select', { 'aria-label': 'Order' }, h('option', { value: '' }, 'Choose the order…'),
      ...orders.map((o) => h('option', { value: o.reference }, `${o.name} · $${o.amount} · ${o.flights} flight${o.flights === 1 ? '' : 's'}${o.booked ? ` · booked ${fmtDay.format(asDate(o.booked))}` : ''} · ${o.reference}`))) as HTMLSelectElement;
    const go = btn('Apply', () => sel.value && act(go, 'etransfer-apply', { row: String(t.row), reference: sel.value }, refresh));
    p.append(h('p', { class: 'adm__muted' }, `Counts this $${t.amount} as the payment for the order: the certificates are issued and any booking is marked paid.`), sel, go);
  }

  // ---------- one day ----------
  /** A day from the full load, or (outside its range) its own request. */
  async function dayData(date: string): Promise<DayData> {
    const have = data?.days.find((d) => d.date === date);
    if (have) return have;
    const d: DayData = await api('day', { date });
    return d;
  }

  function day(date: string) {
    show(() => { renderDay(date); });
  }

  async function renderDay(date: string) {
    if (!data) { loading(); return; }
    let d: DayData;
    const inRange = data.days.find((x) => x.date === date);
    if (inRange) d = inRange;
    else {
      loading(`Loading ${fmtLong.format(asDate(date))}…`);
      try { d = await dayData(date); } catch (e) { if (!(e instanceof Error && e.message === 'signin')) app.replaceChildren(btn('← Back', () => overview(), 'adm__link'), errorBox(e)); return; }
    }
    const waivers = data.waivers;
    const reload = () => refresh();
    const head = h('div', { class: 'adm__dayhead' },
      btn('←', () => day(shift(date, -1)), 'adm__btn adm__btn--small'),
      h('h2', {}, fmtLong.format(asDate(date))),
      btn('→', () => day(shift(date, 1)), 'adm__btn adm__btn--small'));
    const info = h('div', { class: 'adm__info' },
      h('p', {}, h('strong', {}, 'Status: '), d.day?.status || 'Nothing posted'),
      d.day ? h('p', { class: 'adm__muted' }, `${d.day.weather ? 'Forecast: ' + d.day.weather + ' · ' : ''}${d.day.instructor ? 'Instructor signed up' : 'No instructor yet'} · ${d.day.students} student${d.day.students === 1 ? '' : 's'}${d.day.manual ? ` · ${d.day.manual} guest entr${d.day.manual === 1 ? 'y' : 'ies'} typed on the schedule` : ''}`) : null,
      d.avail ? h('p', { class: 'adm__muted' }, `${d.avail.remaining} guest spot${d.avail.remaining === 1 ? '' : 's'} left${d.avail.kind === 'weekend' ? (d.avail.open ? ' · open to pay at the field' : ' · paid flights only until opened') : ''}${d.avail.confirmed ? ' · confirmed' : ''}`) : h('p', { class: 'adm__muted' }, 'Not bookable online (past, more than 4 weeks out, or not on the schedule).'));

    const active = d.bookings.filter((b) => b.status !== 'Cancelled');
    const cancelled = d.bookings.filter((b) => b.status === 'Cancelled');
    const addBox = h('div', {});
    const add = d.avail ? btn('+ Add a booking', () => addForm(d, addBox, reload)) : null;

    app.replaceChildren(
      btn('← All days', () => overview(), 'adm__link'),
      head, info,
      h('h3', {}, active.length ? `Bookings (${active.reduce((s, b) => s + b.people, 0)} people)` : 'No bookings'),
      ...active.map((b) => bookingCard(b, waivers, reload)),
      add || '', addBox,
      walkinSection(date, waivers, reload),
      standbySection(d, reload),
      cancelled.length ? h('details', { class: 'adm__cancelled' }, h('summary', {}, `${cancelled.length} cancelled`),
        ...cancelled.map((b) => h('p', { class: 'adm__muted' }, `${clock(b.start)} ${b.name} (${b.people})${b.notes ? ' · ' + b.notes.split('\n').pop() : ''}`))) : '');
  }

  /** Walk-ins: tick the waivers signed for one flight, give the time, and it becomes a booking. */
  function walkinSection(date: string, waivers: Waiver[], reload: () => void) {
    const sec = h('section', { class: 'adm__walkin' }, h('h3', {}, 'Walk-in from waivers'));
    if (!waivers.length) { sec.append(h('p', { class: 'adm__muted' }, 'No recent waivers waiting to be put on a booking.')); return sec; }
    const today = data?.today || '';
    const boxes: HTMLInputElement[] = [];
    const item = (w: Waiver) => {
      const c = h('input', { type: 'checkbox', value: w.id }) as HTMLInputElement;
      boxes.push(c);
      return h('li', {}, h('label', { class: 'adm__check' }, c,
        ` ${w.name}${w.age < 18 && w.guardian ? ` (${w.age}, with ${w.guardian})` : ''} · signed ${fmtDay.format(asDate(w.signedDate))} ${new Date(w.signed).toLocaleTimeString('en-CA', { hour: 'numeric', minute: '2-digit' })}`));
    };
    const thatDay = waivers.filter((w) => w.signedDate === date);
    const other = waivers.filter((w) => w.signedDate !== date);
    const now = new Date();
    const nowTime = `${String(now.getHours()).padStart(2, '0')}:${String(Math.floor(now.getMinutes() / 5) * 5).padStart(2, '0')}`;
    const time = h('input', { type: 'time', value: date === today ? nowTime : '12:00', 'aria-label': 'Time of the flight', step: '300' }) as HTMLInputElement;
    const status = h('select', { 'aria-label': 'Status' }, h('option', { value: 'Flown' }, 'Flown'), h('option', { value: 'Held' }, 'Booked, not flown yet')) as HTMLSelectElement;
    if (date > today) status.value = 'Held';
    const payment = h('select', { 'aria-label': 'Payment' }, ...['Paid at the field', 'Pay at the field', 'E-transfer (paid)', 'Paid online', 'Gift'].map((v) => h('option', { value: v }, v))) as HTMLSelectElement;
    const interest = h('select', { 'aria-label': 'Interest' }, h('option', { value: 'Discovery flight' }, 'Discovery flight'), h('option', { value: 'First lesson' }, 'First lesson')) as HTMLSelectElement;
    const thanks = h('input', { type: 'checkbox', checked: '' }) as HTMLInputElement;
    const go = btn('Make the booking', () => {
      const ids = boxes.filter((b) => b.checked).map((b) => b.value);
      if (!ids.length || !time.value) return;
      act(go, 'walkin', { date, start: time.value, waivers: ids.join(','), status: status.value, payment: payment.value, interest: interest.value, thanks: thanks.checked ? 'yes' : 'no' }, reload);
    });
    sec.append(
      h('p', { class: 'adm__muted' }, 'Tick everyone on the same flight. The first one ticked is the contact.'),
      thatDay.length ? h('ul', { class: 'adm__standby' }, ...thatDay.map(item)) : h('p', { class: 'adm__muted' }, 'No waivers signed on this day yet.'),
      other.length ? h('details', {}, h('summary', {}, `Other recent waivers (${other.length})`), h('ul', { class: 'adm__standby' }, ...other.map(item))) : '',
      h('div', { class: 'adm__row' }, h('label', { class: 'adm__field' }, 'Time', time), h('label', { class: 'adm__field' }, 'Status', status)),
      h('div', { class: 'adm__row' }, h('label', { class: 'adm__field' }, 'Payment', payment), h('label', { class: 'adm__field' }, 'Interest', interest)),
      date < today ? h('label', { class: 'adm__check' }, thanks, ' Send the thank-you note now') : h('p', { class: 'adm__muted' }, 'The thank-you note goes the evening after the flight.'),
      go);
    return sec;
  }

  function bookingCard(b: Booking, waivers: Waiver[], reload: () => void) {
    const panel = h('div', { class: 'adm__panel' });
    const open = (fill: (p: HTMLElement) => void) => { panel.replaceChildren(); fill(panel); };
    const badge = (t: string, cls = '') => h('span', { class: `adm__badge ${cls}` }, t);
    const statusCls = b.status === 'Requested' ? 'adm__badge--warn' : b.status === 'No-show' ? 'adm__badge--bad' : b.status === 'Flown' ? 'adm__badge--good' : '';
    const pay = /E-transfer$/.test(b.payment) ? badge('E-transfer awaited', 'adm__badge--warn') : badge(b.payment || 'Payment not stated');

    const actions = h('div', { class: 'adm__actions' });
    const setStatus = (label: string, status: string) => {
      const x = btn(label, () => act(x, 'status', { booking: b.id, status }, reload));
      return x;
    };
    if (b.status === 'Requested') actions.append(setStatus('Confirm (emails guest)', 'Confirmed'));
    if (b.status !== 'Flown') actions.append(setStatus('Flown', 'Flown'));
    if (b.status !== 'No-show') actions.append(setStatus('No-show', 'No-show'));
    if (b.status === 'Flown' || b.status === 'No-show') actions.append(setStatus('Undo', 'Held'));
    actions.append(
      btn('Move', () => open((p) => moveForm(p, b, reload))),
      btn('Message', () => open((p) => messageForm(p, 'message', { booking: b.id }, `To ${b.email}`, reload))),
      btn('Cancel', () => open((p) => cancelForm(p, b, reload)), 'adm__btn adm__btn--bad'));

    // Each flyer: their waiver, or a way to give them one: link a recent waiver, or say they are the same person as
    // a flyer who has one (merges the two and their contacts). Any flyer can be taken off the booking.
    const withWaiver = b.flyers.filter((f) => f.waiver);
    const flyers = h('ul', { class: 'adm__flyers' }, ...b.flyers.map((f) => {
      const li = h('li', {}, h('span', {}, f.name || 'Unnamed', ' ',
        f.waiver ? badge('Waiver ✓', 'adm__badge--good') : badge('No waiver', 'adm__badge--warn'), f.flown === 'No' ? badge('Did not fly', 'adm__badge--bad') : ''));
      const tools = h('div', { class: 'adm__flyertools' });
      if (!f.waiver && (waivers.length || withWaiver.length)) {
        const sel = h('select', { 'aria-label': `Waiver for ${f.name}` }, h('option', { value: '' }, 'Give a waiver…'),
          waivers.length ? h('optgroup', { label: 'Link a recent waiver' }, ...waivers.map((w) => h('option', { value: 'w:' + w.id }, `${w.name} (${new Date(w.signed).toLocaleDateString('en-CA')})`))) : '',
          withWaiver.length ? h('optgroup', { label: 'Same person as' }, ...withWaiver.map((o) => h('option', { value: 'm:' + o.id }, o.name))) : '') as HTMLSelectElement;
        const go = btn('Apply', () => {
          const [kind, val] = [sel.value.slice(0, 1), sel.value.slice(2)];
          if (kind === 'w') act(go, 'link-waiver', { booking: b.id, waiver: val, flyer: f.id }, reload);
          if (kind === 'm') act(go, 'flyer-merge', { booking: b.id, keep: val, drop: f.id }, reload);
        }, 'adm__btn adm__btn--small');
        tools.append(sel, go);
      }
      if (b.flyers.length > 1) {
        const rm = btn('Remove', () => {
          if (rm.dataset.sure) act(rm, 'flyer-remove', { booking: b.id, flyer: f.id }, reload);
          else { rm.dataset.sure = '1'; rm.textContent = f.waiver ? 'Remove? Waiver is kept' : 'Remove? Tap again'; }
        }, 'adm__link');
        tools.append(rm);
      }
      // A lone Remove sits on the name's line; with the waiver picker it goes beside Apply.
      if (tools.childElementCount === 1 && !tools.querySelector('select')) li.firstElementChild!.append(' ', tools.firstElementChild!);
      else if (tools.childElementCount) li.append(tools);
      return li;
    }));
    const notes = h('textarea', { rows: '2', 'aria-label': 'Notes' }) as HTMLTextAreaElement;
    notes.value = b.notes;
    const saveNotes = btn('Save notes', () => act(saveNotes, 'note', { booking: b.id, notes: notes.value }, reload), 'adm__btn adm__btn--small');

    return h('article', { class: 'adm__card' },
      h('p', { class: 'adm__time' }, `${clock(b.start)} to ${clock(endOf(b.start, b.people))}`),
      h('p', {}, h('strong', {}, b.name), ` · ${b.people} ${b.people === 1 ? 'person' : 'people'} · ${b.interest}`),
      h('p', { class: 'adm__badges' }, badge(b.status, statusCls), pay, badge(`Waivers ${b.waivers}/${b.people}`, b.waivers < b.people ? 'adm__badge--warn' : 'adm__badge--good'),
        b.followUp ? badge('Thank-you sent') : ''),
      h('p', {}, h('a', { href: `tel:${b.phone}` }, b.phone), ' · ', h('a', { href: `mailto:${b.email}` }, b.email)),
      b.certificates ? h('p', { class: 'adm__muted' }, `Certificates: ${b.certificates}`) : null,
      b.message ? h('p', { class: 'adm__muted' }, `“${b.message}”`) : null,
      b.movedFrom ? h('p', { class: 'adm__muted' }, `Moved from ${b.movedFrom}`) : null,
      b.flexible === 'Yes' ? h('p', { class: 'adm__muted' }, 'Either weekend day works') : null,
      flyers,
      h('div', { class: 'adm__notes' }, notes, saveNotes),
      actions, panel);
  }

  function messageForm(p: HTMLElement, action: string, data: Record<string, string>, toLine: string, reload: () => void) {
    const subject = h('input', { type: 'text', 'aria-label': 'Subject', placeholder: 'Subject' }) as HTMLInputElement;
    const body = h('textarea', { rows: '6', 'aria-label': 'Message', placeholder: 'Message. "Hi <first name>," and the club sign-off are added.' }) as HTMLTextAreaElement;
    const send = btn('Send', () => {
      if (!subject.value.trim() || !body.value.trim()) return;
      act(send, action, { ...data, subject: subject.value, body: body.value }, reload);
    });
    p.append(h('p', { class: 'adm__muted' }, toLine), subject, body, send);
  }

  function cancelForm(p: HTMLElement, b: Booking, reload: () => void) {
    const notify = h('input', { type: 'checkbox', id: `n-${b.id}`, checked: '' }) as HTMLInputElement;
    const msg = h('textarea', { rows: '3', 'aria-label': 'Message to the guest', placeholder: 'Optional message to the guest' }) as HTMLTextAreaElement;
    const go = btn('Yes, cancel this booking', () => act(go, 'cancel', { booking: b.id, notify: notify.checked ? 'yes' : 'no', message: msg.value }, reload), 'adm__btn adm__btn--bad');
    p.append(h('p', {}, `Cancel ${b.name}'s booking at ${clock(b.start)}? The slot is freed and the schedule cell cleared.`),
      h('label', { class: 'adm__check' }, notify, ' Email the guest'), msg, go);
  }

  async function moveForm(p: HTMLElement, b: Booking, reload: () => void) {
    const date = h('input', { type: 'date', value: b.date, 'aria-label': 'New date' }) as HTMLInputElement;
    const times = h('select', { 'aria-label': 'New start time' }) as HTMLSelectElement;
    const go = btn('Move (emails guest)', () => times.value && act(go, 'move', { booking: b.id, date: date.value, start: times.value }, reload));
    const fill = async () => {
      times.replaceChildren(h('option', { value: '' }, 'Loading times…'));
      try {
        const d: DayData = await dayData(date.value);
        const free = (d.avail?.slots || []).filter((_s, i, all) => all.slice(i, i + b.people).length === b.people && all.slice(i, i + b.people).every((x) => x.free || (date.value === b.date && x.time >= b.start && x.time < endOf(b.start, b.people))));
        times.replaceChildren(...(free.length ? free.map((s) => h('option', { value: s.time }, clock(s.time))) : [h('option', { value: '' }, 'No free times that day')]));
      } catch (e) {
        times.replaceChildren(h('option', { value: '' }, e instanceof Error ? e.message : 'Could not load times'));
      }
    };
    date.addEventListener('change', fill);
    p.append(h('p', { class: 'adm__muted' }, 'Pick a new day and time.'), h('div', { class: 'adm__row' }, date, times), go);
    fill();
  }

  function addForm(d: DayData, box: HTMLElement, reload: () => void) {
    const field = (label: string, input: HTMLElement) => h('label', { class: 'adm__field' }, label, input);
    const people = h('select', { name: 'people' }, ...Array.from({ length: maxGroup }, (_, i) => h('option', { value: String(i + 1) }, String(i + 1)))) as HTMLSelectElement;
    const start = h('select', { name: 'start' }, ...(d.avail?.slots || []).filter((s) => s.free).map((s) => h('option', { value: s.time }, clock(s.time)))) as HTMLSelectElement;
    const payment = h('select', { name: 'payment' }, ...['Pay at the field', 'Paid online', 'Gift', 'E-transfer'].map((v) => h('option', { value: v }, v))) as HTMLSelectElement;
    const interest = h('select', { name: 'interest' }, h('option', { value: 'Discovery flight' }, 'Discovery flight'), h('option', { value: 'First lesson' }, 'First lesson')) as HTMLSelectElement;
    const form = h('form', { class: 'adm__card adm__add' },
      h('h3', {}, 'Add a booking'),
      field('People', people), field('Start', start),
      field('Name', h('input', { name: 'name', type: 'text', required: '' })),
      field('Email', h('input', { name: 'email', type: 'email', required: '' })),
      field('Phone', h('input', { name: 'phone', type: 'tel', required: '' })),
      field('Payment', payment),
      field('Certificate codes (if paid online or a gift)', h('input', { name: 'codes', type: 'text' })),
      field('Interest', interest),
      h('label', { class: 'adm__check' }, h('input', { name: 'weight_ok', type: 'checkbox', value: 'yes', required: '' }), ' Everyone is under the weight limit'),
      field('Message (optional)', h('textarea', { name: 'message', rows: '2' })),
      h('input', { type: 'hidden', name: 'date', value: d.date }),
      h('p', { class: 'adm__muted' }, 'The guest gets the usual confirmation and reminders.'));
    const save = h('button', { type: 'submit', class: 'adm__btn' }, 'Add booking') as HTMLButtonElement;
    form.append(save);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const data = Object.fromEntries(new FormData(form) as unknown as Iterable<[string, string]>);
      act(save, 'add', data, reload);
    });
    box.replaceChildren(form);
  }

  function standbySection(d: DayData, reload: () => void) {
    if (!d.standby.length) return h('p', { class: 'adm__muted' }, 'No one on the standby list for this day.');
    const boxes: HTMLInputElement[] = [];
    const panel = h('div', {});
    const list = h('ul', { class: 'adm__standby' }, ...d.standby.map((s) => {
      const c = h('input', { type: 'checkbox', value: s.token, checked: '' }) as HTMLInputElement;
      boxes.push(c);
      return h('li', {}, h('label', { class: 'adm__check' }, c, ` ${s.name} (${s.people}) · ${s.scope === 'Any' ? 'any weekend' : s.scope === 'Weekend' ? 'either day' : 'this day'} · ${s.status}`),
        h('p', { class: 'adm__muted' }, h('a', { href: `tel:${s.phone}` }, s.phone), ' · ', h('a', { href: `mailto:${s.email}` }, s.email), s.codes ? ` · paid: ${s.codes}` : ''));
    }));
    const msg = btn('Message the ticked people', () => {
      const tokens = boxes.filter((b) => b.checked).map((b) => b.value).join(',');
      panel.replaceChildren();
      messageForm(panel, 'standby-message', { tokens }, `To ${tokens.split(',').filter(Boolean).length} on the standby list`, reload);
    });
    return h('section', {}, h('h3', {}, `Standby (${d.standby.length})`), list, msg, panel);
  }

  // ---------- start ----------
  const m = /#t=([\w\-=]+)/.exec(location.hash);
  if (m) {
    try { localStorage.setItem(KEY, m[1]); } catch { /* storage blocked */ }
    history.replaceState(null, '', location.pathname);
  }
  if (token()) {
    try { data = JSON.parse(localStorage.getItem(DATA) || 'null'); } catch { data = null; }
    overview();
    refresh();
  } else signIn();
</script>

