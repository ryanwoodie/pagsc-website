---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Section from '../../../components/Section.astro';
import Button from '../../../components/Button.astro';
import { facts } from '../../../lib/facts';
import { href } from '../../../lib/url';
---
<Base
  title="Welcome pack sent"
  description={`The ${facts.club.name} welcome pack is on its way to your inbox.`}
  noindex
>
  <PageHero title="Check your email.">
    <p class="lead">The welcome pack is on its way. If it does not arrive in a few minutes, look in your spam folder.</p>
    <div class="actions"><Button href="/discovery-flight/#request">Book a first lesson</Button></div>
  </PageHero>
  <Section variant="plain" labelledby="next-h">
    <h2 id="next-h">Your first lesson is a Discovery Flight</h2>
    <p>Join when you are ready with the membership form.</p>
    <p class="actions">
      <a class="more" href={facts.links.membership_form} rel="noopener">Membership form</a>
      <a class="more" href={href('/learn-to-fly/')}>Back to Learn to fly</a>
    </p>
  </Section>
</Base>
