---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import GliderOutline from '../../components/GliderOutline.astro';
import Callout from '../../components/Callout.astro';
import BookButton from '../../components/BookButton.astro';
import { facts, num, listJoin } from '../../lib/facts';

const outlines = ['k7', 'ka6e', 'phoebus'] as const;
const k7 = facts.fleet[0]!;
const ratio = Number(k7.best_glide.split(':')[0]);
const glideKm = Math.round((ratio * 2000 * 0.3048) / 1000);
const slug = (s: string) => s.toLowerCase().normalize('NFD').replace(/[^\w\s-]/g, '').replace(/\s+/g, '-');
---
<Base
  title="The club and the fleet"
  description={`The ${facts.club.name} is a non-profit club founded in ${facts.club.founded}, flying a Schleicher K7, a Ka 6E and a Bölkow Phoebus C from ${facts.location.airfield}.`}
>
  <PageHero title="The club">
    <p class="lead">A friendly non-profit club, founded in {facts.club.founded}, flying from {facts.location.airfield}. We are affiliated with the {listJoin(facts.club.affiliations)}.</p>
    <div class="actions"><BookButton /></div>
  </PageHero>

  <Section variant="plain" labelledby="team-h">
    <h2 id="team-h" class="visually-hidden">A team sport</h2>
    <p class="lead">Gliding is a team sport. It takes a crew to launch a glider, and members keep the cost of flying low by pitching in: driving the winch, running a wing, looking after the gliders and the field.</p>
  </Section>

  <Section labelledby="fleet-h">
    <h2 id="fleet-h">The fleet</h2>
    <p>Three gliders: a two-seat trainer and two single-seaters.</p>
    <div class="fleet">
      {facts.fleet.map((g, i) => (
        <article class="glider" aria-labelledby={slug(g.name)}>
          <div class="glider__head">
            <GliderOutline type={outlines[i]!} />
            <div>
              <h3 id={slug(g.name)}>{g.name}</h3>
              <p class="label">{g.role}</p>
              <p>{g.description}</p>
            </div>
          </div>
          <dl class="specs">
            <div><dt>Seats</dt><dd>{g.seats}</dd></div>
            <div><dt>Wingspan</dt><dd>{g.wingspan_m.toFixed(1)} m</dd></div>
            <div><dt>Best glide</dt><dd>{g.best_glide}</dd></div>
            <div><dt>Min. sink</dt><dd>{g.min_sink_ms.toFixed(2)} m/s</dd></div>
            <div><dt>Empty weight</dt><dd>{g.empty_weight_kg} kg</dd></div>
            <div><dt>Introduced</dt><dd>{g.introduced}</dd></div>
          </dl>
        </article>
      ))}
    </div>
    <Callout tone="sky" lead="Reading the numbers">
      <p>A best glide of {k7.best_glide} means {ratio} metres forward for every metre of height lost: about {glideKm} km from a {num(facts.discovery_flight.launch_height_feet)} ft launch in still air. Minimum sink is how slowly the glider descends when flown for time aloft.</p>
    </Callout>
    <div class="actions"><BookButton /></div>
  </Section>
</Base>
<style>
  .fleet {
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    margin: 20px 0 24px;
  }
  .glider {
    padding: 20px 0;
  }
  .glider + .glider {
    border-top: 1px solid var(--rule);
  }
  .glider__head {
    display: grid;
    gap: 12px 24px;
  }
  .glider h3 {
    margin: 0;
  }
  .glider .label {
    margin: 2px 0 6px;
  }
  .specs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 14px 0 0;
  }
  .specs dt {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--grey);
  }
  .specs dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.15;
  }
  @media (min-width: 760px) {
    .glider__head {
      grid-template-columns: 224px minmax(0, 1fr);
      align-items: center;
    }
    .specs {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
</style>
