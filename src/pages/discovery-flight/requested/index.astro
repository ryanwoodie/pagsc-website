---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Section from '../../../components/Section.astro';
import Button from '../../../components/Button.astro';
import { facts } from '../../../lib/facts';
import { href } from '../../../lib/url';
---
<Base
  title="Request received"
  description={`Your Discovery Flight request is with the ${facts.club.name}. A club member will reply to confirm a date and an arrival time.`}
  noindex
>
  <PageHero title="Thanks. Your request is in.">
    <p class="lead">A club member will reply to confirm a date and an arrival time.</p>
  </PageHero>

  <Section variant="plain" labelledby="pay-h">
    <h2 id="pay-h">Paying</h2>
    <p>Pay online now, or by e-transfer on the day.</p>
    <div class="actions"><Button href={facts.links.discovery_flight_payment} external>Pay for a Discovery Flight</Button></div>
  </Section>

  <Section labelledby="before-h">
    <h2 id="before-h">Before you come</h2>
    <p>What to bring, how the day runs, and what happens if the weather turns.</p>
    <p><a class="more" href={href('/discovery-flight/#day-h')}>Your first day</a></p>
  </Section>
</Base>
