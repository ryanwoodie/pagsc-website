---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Steps from '../../components/Steps.astro';
import Callout from '../../components/Callout.astro';
import BookButton from '../../components/BookButton.astro';
import Qa from '../../components/Qa.astro';
import BookingCalendar from '../../components/BookingCalendar.astro';
import Photo from '../../components/Photo.astro';
import guestPhoto from '../../assets/photos/guest-front-seat.jpg';
import cockpitPhoto from '../../assets/photos/cockpit-view.jpg';
import { facts, df, money, lcfirst, launchHeight } from '../../lib/facts';
import { beforeFirstFlight } from '../../lib/faq';
import { href } from '../../lib/url';
import { clubJsonLd } from '../../lib/schema';

const dt = facts.location.drive_times;
const weekdays = lcfirst(df.weekdays);
---
<Base
  title={`Discovery Flight in a glider, ${money(df.price)}`}
  description={`Your first flight in a glider, with a club pilot, from ${facts.location.airfield} near Prince Albert. ${money(df.price)}, no experience or membership needed. Request a date.`}
  jsonLd={clubJsonLd(Astro.site!, import.meta.env.BASE_URL)}
>
  <PageHero label="Discovery Flight" title="Your first flight in a glider">
    <p class="lead">A winch launch to about {launchHeight} in a two-seat glider, with a club pilot beside you the whole time. <strong class="inline-price">{money(df.price)}.</strong></p>
    <div class="actions">
      <BookButton showPrice />
      <a class="more" href="#request">or book a date first</a>
    </div>
    <p class="fine">For you or as a gift. After you buy, choose your date with us. Groups of {df.group_minimum} or more: <a href={facts.links.discovery_flight_group_payment} rel="noopener">buy at the group rate, {money(df.group_price_each)} each</a>.</p>
    <Photo slot="media" src={guestPhoto} alt="A smiling guest in the front seat of the club's two-seat glider, canopy open, with the pilot in the back seat" crop="4 / 3" position="center 55%" eager />
  </PageHero>

  <Section variant="plain" labelledby="what-h">
    <div class="grid grid--2">
      <div>
        <h2 id="what-h">What happens</h2>
        <p class="lead">The winch pulls the glider into the air in seconds. At about {launchHeight} your pilot releases the cable, and the flying goes quiet. Depending on the day you will be up for {df.duration_minutes} minutes.</p>
        <p>How long depends on the air. On a calm day the flight is a smooth glide back down from the launch. When there is rising air, your pilot can use it to stay up longer and show you more.</p>
        <Photo class="cockpit" src={cockpitPhoto} alt="View from the front seat in flight: a student in a headset looks out over green prairie fields and the airfield below" crop="4 / 5" position="center 40%" sizes="(min-width: 760px) 45vw, 100vw" />
      </div>
      <div>
        <h2 id="glance-h">At a glance</h2>
        <ul class="defs">
          <li><strong>Price</strong> {money(df.price)}, or {money(df.group_price_each)} each for a group of {df.group_minimum} or more</li>
          <li><strong>When</strong> <span>{lcfirst(df.when)}; {weekdays}</span></li>
          <li><strong>Where</strong> {facts.location.airfield}, {dt.prince_albert} from Prince Albert and {dt.saskatoon} from Saskatoon</li>
          <li><strong>Who can fly</strong> maximum weight {df.max_weight_lbs} lbs. No experience and no membership needed.</li>
          <li><strong>Season</strong> {lcfirst(df.season)}</li>
        </ul>
      </div>
    </div>
  </Section>

  <Section labelledby="how-h">
    <h2 id="how-h">How it works</h2>
    <Steps
      row
      items={[
        { title: 'Buy your flight', text: `${money(df.price)} online, for yourself or as a gift.` },
        { title: 'Book your date', text: 'Tell us which days suit you with the form below. A club member replies with a date and an arrival time.' },
        { title: 'Come out and fly', text: 'Check the day is on before you leave home, then meet us at the field.' },
      ]}
    />
  </Section>

  <Section labelledby="day-h">
    <h2 id="day-h">Your first day</h2>
    <div class="grid grid--2">
      <div>
        <h3>Bring</h3>
        <ul class="ticks">{df.bring.map((b) => <li>{b}</li>)}</ul>
      </div>
      <div>
        <h3>How the day runs</h3>
        <ol class="day-list">{df.day.map((d) => <li>{d}</li>)}</ol>
      </div>
    </div>
    <Callout lead="Weather">
      <p>Gliding depends on the weather. If your day is cancelled, we rebook you at no charge, and a flight you've paid for carries over to the new date. Prepaid flights don't expire, and we refund on request.</p>
    </Callout>
  </Section>

  <Section labelledby="learn-h">
    <h2 id="learn-h">Thinking of learning to fly?</h2>
    <p class="lead">This flight is also your first lesson. Choose "A first lesson" when you book so we know, and ask your pilot anything on the day.</p>
    <p><a class="more" href={href('/learn-to-fly/')}>What learning to fly involves</a></p>
  </Section>

  <Section id="request" labelledby="req-h">
    <h2 id="req-h">Book your date</h2>
    <p>Bought a flight, been given one, or want to check dates before you buy? Pick a day and a time.</p>
    <BookingCalendar />
  </Section>

  <Section labelledby="gift-h">
    <h2 id="gift-h">Give a flight as a gift</h2>
    <p class="lead">A Discovery Flight makes a good present for anyone who has looked up and wondered.</p>
    <p>Buy it online now; gift flights don't expire. The person flying books their date with the <a href="#request">booking form</a> above, or by emailing <a href={`mailto:${facts.contact.email}`}>{facts.contact.email}</a>.</p>
    <div class="actions"><BookButton label="Buy a gift flight" showPrice /></div>
  </Section>

  <Section labelledby="faq-h">
    <h2 id="faq-h">Before a first flight</h2>
    <Qa items={beforeFirstFlight} />
  </Section>
</Base>

<style>
  .fine {
    margin: 10px 0 0;
    font-size: 0.95rem;
    color: var(--grey);
  }
  .inline-price {
    font-family: var(--font-display);
    font-size: 1.6em;
    font-weight: 700;
    color: var(--orange-dark);
    white-space: nowrap;
  }
  :global(.cockpit) {
    margin-top: 8px;
    max-width: 420px;
  }
  .day-list {
    padding-left: 1.3em;
  }
  .day-list li {
    margin-bottom: 8px;
  }
  @media (min-width: 480px) {
    .defs li {
      grid-template-columns: 8em minmax(0, 1fr);
    }
  }
</style>
