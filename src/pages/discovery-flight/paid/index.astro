---
// Where the Wave checkout sends buyers after paying (set as the checkout's redirect, if Wave allows).
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Section from '../../../components/Section.astro';
import Button from '../../../components/Button.astro';
import BookingCalendar from '../../../components/BookingCalendar.astro';
import { facts } from '../../../lib/facts';
---
<Base
  title="Thanks for buying a Discovery Flight"
  description={`Your Discovery Flight with the ${facts.club.name} is paid. Choose your date.`}
  noindex
>
  <PageHero title="Thanks. Your flight is paid.">
    <p class="lead">Now pick a day and a time. If it's a gift, pass this page on to the person flying.</p>
    <div class="actions"><Button href="#request">Book your flying day</Button></div>
  </PageHero>
  <Section id="request" variant="plain" labelledby="req-h">
    <h2 id="req-h">Book your flying day</h2>
    <BookingCalendar paid />
  </Section>
</Base>
