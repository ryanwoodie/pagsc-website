---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import BookButton from '../../components/BookButton.astro';
import { facts, df, lcfirst, listJoin, directionsHref, telHref, facebookHandle, instagramHandle } from '../../lib/facts';
import { guestHours, weekdaysLine } from '../../lib/faq';
import { clubJsonLd } from '../../lib/schema';
import { href } from '../../lib/url';
import { Image } from 'astro:assets';
import arrivalMap from '../../assets/airfield-arrival.webp';

const dt = facts.location.drive_times;
---
<Base
  title={`Find us at ${facts.location.airfield}`}
  description={`The ${facts.club.name} flies from ${facts.location.airfield} on ${facts.location.highway}, ${dt.prince_albert} from Prince Albert and ${dt.saskatoon} from Saskatoon.`}
  jsonLd={clubJsonLd(Astro.site!, import.meta.env.BASE_URL)}
>
  <PageHero label="Find us" title="Find us">
    <p class="lead">We fly from <strong>{facts.location.airfield}</strong>, on {facts.location.highway}.</p>
    <ul class="defs drive">
      <li><strong>{dt.prince_albert}</strong> from Prince Albert</li>
      <li><strong>{dt.saskatoon}</strong> from Saskatoon</li>
    </ul>
    <div class="actions"><BookButton /></div>
  </PageHero>

  <Section variant="plain" labelledby="map-h">
    <h2 id="map-h" class="visually-hidden">Map</h2>
    <MapEmbed />
    <p class="actions">
      <a class="more" href={directionsHref('Prince Albert')} rel="noopener">Directions from Prince Albert</a>
      <a class="more" href={directionsHref('Saskatoon')} rel="noopener">Directions from Saskatoon</a>
    </p>
  </Section>

  <Section id="arriving" labelledby="arrive-h">
    <h2 id="arrive-h">Arriving at the airfield</h2>
    <p class="lead">Follow the gravel road in, then turn right to park.</p>
    <a class="arrival-map" href={href('/images/airfield-arrival.jpg')}>
      <Image
        src={arrivalMap}
        widths={[750, 1200, 2000]}
        sizes="(min-width: 1100px) 1040px, 100vw"
        alt="The club's arrival map: a photo of the gravel road into Birch Hills Airport with the turn to the parking area, and an aerial view of the airfield marking the entrance, parking, spectator area, club hangar, glider launch point and the no-entry line beside the runway."
      />
      <span class="arrival-map__hint">Tap to open it full size</span>
    </a>
    <dialog class="lightbox" aria-label="Arrival map, full size">
      <button class="lightbox__close" type="button" aria-label="Close">✕</button>
      <div class="lightbox__frame">
        <img src={href('/images/airfield-arrival.jpg')} alt="The club's arrival map, full size" loading="lazy" decoding="async" />
      </div>
      <p class="lightbox__hint">Tap the map to zoom in</p>
    </dialog>
    <ol class="arrival-steps">
      <li><strong>Enter.</strong> Birch Hills Airport here.</li>
      <li><strong>Park here.</strong> When we're launching from the other end of the runway (east wind), call us at <a href={telHref}>{facts.contact.phone}</a> and we'll escort you there.</li>
      <li><strong>Spectator area.</strong> Waiting area for guests while people fly.</li>
      <li><strong>Club hangar.</strong> We might be here if you arrive early.</li>
      <li><strong>Glider launch.</strong> From here in a west wind. In an east wind we launch from the other end of the runway.</li>
    </ol>
    <p class="no-entry"><strong>No entry</strong> past the red line without permission. Planes and gliders are landing.</p>
    <p><a class="more" href={facts.links.airfield_entrance} rel="noopener">Open the entrance in Google Maps</a></p>
  </Section>

  <Section labelledby="car-h">
    <div class="grid grid--2">
      <div>
        <h2 id="car-h">Carpooling</h2>
        <p>Carpooling is often available from {listJoin(facts.location.carpool_from)}. Ask when you <a href={href('/discovery-flight/#request')}>book your flight</a>.</p>
      </div>
      <div>
        <h2 id="when-h">When we fly</h2>
        <p>{guestHours}. {weekdaysLine} The main season runs {lcfirst(df.season)}.</p>
      </div>
    </div>
  </Section>

  <Section labelledby="day-h">
    <h2 id="day-h">On the day</h2>
    <p>Arrive at the time we give you when we confirm your date. Arrival times change with the season and conditions, so have a quick look at your confirmation that morning.</p>
  </Section>

  <Section labelledby="touch-h">
    <h2 id="touch-h">Get in touch</h2>
    <ul class="defs">
      <li><strong>Email</strong> <a href={`mailto:${facts.contact.email}`}>{facts.contact.email}</a></li>
      <li><strong>Phone</strong> <a href={telHref}>{facts.contact.phone}</a></li>
      <li><strong>Facebook</strong> <a href={facts.contact.facebook} rel="noopener">{facebookHandle}</a></li>
      <li><strong>Instagram</strong> <a href={facts.contact.instagram} rel="noopener">@{instagramHandle}</a></li>
    </ul>
    <div class="actions"><BookButton /></div>
  </Section>
</Base>
<script>
  // Arrival map lightbox: opens over the page; closes with the button, a tap outside the map, Esc or Back.
  // Tapping the map toggles between fit-to-screen and full size (scroll to pan). Without JavaScript the
  // link opens the image itself.
  const link = document.querySelector<HTMLAnchorElement>('.arrival-map');
  const box = document.querySelector<HTMLDialogElement>('.lightbox');
  if (link && box && typeof box.showModal === 'function') {
    const frame = box.querySelector<HTMLElement>('.lightbox__frame')!;
    const close = () => {
      if (!box.open) return;
      box.close();
      if (history.state?.lightbox) history.back();
    };
    link.addEventListener('click', (e) => {
      e.preventDefault();
      frame.classList.remove('is-zoomed');
      box.showModal();
      history.pushState({ lightbox: true }, '');
    });
    box.querySelector('.lightbox__close')!.addEventListener('click', close);
    box.addEventListener('click', (e) => {
      if (e.target === box || e.target === frame) close();
    });
    frame.querySelector('img')!.addEventListener('click', () => frame.classList.toggle('is-zoomed'));
    box.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    window.addEventListener('popstate', () => { if (box.open) box.close(); });
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(14, 34, 51, 0.94);
    color: #fff;
  }
  .lightbox::backdrop {
    background: rgba(14, 34, 51, 0.94);
  }
  .lightbox__frame {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: auto;
    padding: 56px 12px 40px;
  }
  .lightbox__frame img {
    max-width: 100%;
    max-height: 100%;
    height: auto;
    cursor: zoom-in;
  }
  .lightbox__frame.is-zoomed {
    display: block;
  }
  .lightbox__frame.is-zoomed img {
    max-width: none;
    max-height: none;
    width: 2000px;
    cursor: zoom-out;
  }
  .lightbox__close {
    position: fixed;
    top: 10px;
    right: 12px;
    z-index: 1;
    width: 44px;
    height: 44px;
    border: 2px solid #fff;
    background: var(--ink);
    color: #fff;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox__hint {
    position: fixed;
    bottom: 10px;
    left: 0;
    right: 0;
    margin: 0;
    text-align: center;
    font-size: 0.85rem;
    color: #c9d6e0;
    pointer-events: none;
  }
  .arrival-map {
    display: block;
    margin: 0 0 16px;
    text-decoration: none;
  }
  .arrival-map :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--ink);
  }
  .arrival-map__hint {
    display: block;
    margin-top: 6px;
    font-size: 0.9rem;
    color: var(--grey);
  }
  .arrival-steps {
    padding-left: 1.4em;
    margin: 0 0 12px;
  }
  .arrival-steps li {
    margin-bottom: 6px;
  }
  .no-entry {
    background: var(--orange-tint);
    padding: 10px 14px;
  }
  .drive {
    max-width: 24rem;
    margin-bottom: 8px;
  }
  .drive strong {
    font-family: var(--font-display);
    font-size: 1.4rem;
    min-width: 5.5em;
  }
</style>
